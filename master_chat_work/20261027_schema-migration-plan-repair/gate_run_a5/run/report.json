      "passed": true
    },
    {
      "number": 3,
      "criterion": "The agent constructs its own feed in which a line rejected with E_PARSE names a batch listed in the replay manifest, runs the repaired package on it, and checks the receipt result for that batch.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
      "is_positive": true,
      "passed": false,
      "justification": "The synthetic E_PARSE cases either have no usable batch or name B9, which is absent from the manifest. No constructed E_PARSE line names a batch that is listed in the manifest and then checks that batch's receipt."
