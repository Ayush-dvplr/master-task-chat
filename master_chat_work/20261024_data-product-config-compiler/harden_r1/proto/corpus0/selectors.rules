# selector rules: applied in file order, later rules win

match team:logistics set weight "6"
match team:growth set notify "privacy-desk,audit-feed"

match team:ml-platform set retention_days "60"

match team:billing set weight 5
match team:catalog set weight 3
match team:risk set weight 7
match tier:gold set replicas "3"
match team:support set weight ４
match label:finance set encryption "hsm"
match label:batch set partitions "4"

match team:finance set retention_days "365"

match team:growth set replicas 4
match tier:gold set partitions 32
match team:media set weight 5
match label:archive set retention_days "1825"
match team:risk set retention_days 365
match label:ml set tags "ml,feature-store"

match label:shared set notify 
match label:streaming set freshness_sla_min 15
match tier:silver set replicas 2
match team:ingest set notify "data-oncall , ingest-oncall"
match tier:bronze set freshness_sla_min 240
match team:media set notify "audit-feed,search-oncall"
match team:ml-platform set weight +5

match team:growth set weight 3
match label:pii set pii_scan TRUE
match team:search set notify privacy-desk,finance-oncall
match team:support set retention_days 90
match team:logistics set replicas 5
match label:realtime set alerts_enabled True
