<?xml version="1.0"?>
<!--
  Rate cards of this extract, one card per site row; every rate is in mill-cents per kWh.
  The rate of a site row starts from the base element of its card. A card that also carries an
  override element starts from the override value instead of the base value.
  The effective rate of a site row is its rate with its card's cap applied as the programme
  conventions say.
  credit_cents of a chosen offer is the sum, over the intervals of its event, of its interval
  amounts. An interval amount is the offer's relief ticks in that interval times wh_per_tick, times
  the effective rate of the offer's site row, divided by 1000 times millicents_per_cent, rounded
  half to even to whole cents.
-->
<rate_cards>
<card event="R4-0101" site="S3"><base>4000</base><cap>9000</cap></card>
<card event="R4-0102" site="S2"><base>4000</base><cap>9000</cap></card>
<card event="R4-0101" site="S1"><base>4000</base><cap>9000</cap></card>
</rate_cards>
