def pending_bundle_publication(root: Path) -> JsonMap | None:
    path = root / "workspace/revision-transactions/pending.json"
    return load_json(path) if path.is_file() else None


def _stage(publication: BundlePublication, staged: Path) -> None:
    staged.parent.mkdir(parents=True, exist_ok=True)
    if publication.source is None:
        staged.mkdir()
        (staged / "instruction.md").write_text(
            "# PENDING_AUTHORING\n\nAn authoring agent must write the complete task instruction.\n",
            encoding="utf-8",
        )
        (staged / "task.toml").write_text(
            f'[task]\nname = "beta/{publication.name}"\nauthors = []\n',
            encoding="utf-8",
        )
    else:
        before = tree_hash(publication.source)
        shutil.copytree(publication.source, staged)
        if tree_hash(publication.source) != before or tree_hash(staged) != before:
            raise BetaError("stale_bundle_source", "bundle source changed during copy")
    (staged / ".beta-incomplete").write_text("incomplete\n", encoding="utf-8")


def _finalize(target: Path, journal_path: Path, journal: JsonMap, pending: Path) -> None:
    (target / ".beta-incomplete").unlink()
    journal["status"] = "COMMITTED"
from __future__ import annotations

import re
from pathlib import Path
from typing import Final

from core.common import BetaError, JsonMap
from core.bundle_transactions import BundlePublication, publish_bundle, recover_bundle_publication
from core.models import RecoveryAction, RevisionRecord, TaskRecord, TaskStatus, parse_task
from core.settings import settings_hash
from core.state import Store


_TASK_NAME: Final = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
_AUTHORING_STATUS: Final = "PENDING_AUTHORING"


def create_task(
    store: Store,
    name: str,
    *,
    domain: str = "unspecified",
    mode: str = "create",
) -> TaskRecord:
    _validate_name(name)
    task_path = f"workspace/tasks/{name}/task.json"
    try:
        store.load(task_path)
    except BetaError as error:
        if error.code != "not_found":
            raise
    else:
        raise BetaError("task_exists", "task id already exists", name)
    profile_hash = settings_hash(store)
    task = TaskRecord(name, name, 1, profile_hash, TaskStatus.ACTIVE, 0)
    revision = RevisionRecord(name, 1, name, None, profile_hash)
    bundle_relative = _bundle_relative(name, 1, name)
    publish_bundle(
        store,
        BundlePublication(
            bundle_relative,
            (
                (task_path, _task_json(task)),
                (
                    f"workspace/tasks/{name}/revisions/1/revision.json",
                    _revision_json(revision, bundle_relative, domain, mode),
                ),
            ),
            f"create-task:{name}",
            name,
        ),
    )
    return task


def revise_task(store: Store, task_id: str, *, mode: str = "harden") -> RevisionRecord:
    task = parse_task(store.load(f"workspace/tasks/{task_id}/task.json"))
    number = task.current_revision + 1
    revision = RevisionRecord(task_id, number, task.name, task.current_revision, task.profile_hash)
    updated = TaskRecord(
        task.task_id,
        task.name,
        number,
        task.profile_hash,
        task.status,
        task.refinement_rounds,
    )
    source = store.root / _bundle_relative(task_id, task.current_revision, task.name)
    destination_relative = _bundle_relative(task_id, number, task.name)
    publish_bundle(
        store,
        BundlePublication(
            destination_relative,
            (
                (
                    f"workspace/tasks/{task_id}/revisions/{number}/revision.json",
                    _revision_json(revision, destination_relative, "inherited", mode),
                ),
                (f"workspace/tasks/{task_id}/task.json", _task_json(updated)),
            ),
            f"revise-task:{task_id}",
            task.name,
            source,
        ),
    )

