def load_board() -> list[dict]:
    if not BOARD.is_file():
        return []
    return json.loads(BOARD.read_text()).get("rows", [])


def board_set(sha: str, **fields: str) -> None:
    """R5-15: update a board row through tools/board.py set (beside board.json), never by editing the json.
    Rows that are not on the board are left alone; a failure is logged, never raised."""
    if not any(r.get("sha") == sha for r in load_board()):
        return
    tool = BOARD.parent / "tools" / "board.py"
    try:
        out = subprocess.run([sys.executable, str(tool), "set", sha, *(f"{k}={v}" for k, v in fields.items())],
                             cwd=BOARD.parent, capture_output=True, text=True, timeout=30)
        ok, err = out.returncode == 0, out.stderr.strip()[-300:]
    except (OSError, subprocess.TimeoutExpired) as e:
        ok, err = False, repr(e)
    if not ok:
        log("board_set_failed", sha=sha, fields=fields, error=err)


def adopt_one(st: dict, sha: str, session: str | None) -> bool:
    """Track an existing session under `sha`. False when no session can be found."""
    sid = session if session and session_exists(session) else (None if session else find_session(sha))
    if not sid:
        return False
    row = next((r for r in load_board() if r.get("sha") == sha), {})
    st["workers"][sha] = new_worker(sid, row.get("prompt", ""), adopted=True)
    log("adopt", sha=sha, session=sid)
    return True


