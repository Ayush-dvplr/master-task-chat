+ 'decisions':'master_chat_tasks/decisions.jsonl','feedback':'master_chat_tasks/feedback.jsonl',
+ 'lessons':'master_chat_tasks/lessons.jsonl','scores':'master_chat_tasks/registry/scores.jsonl',
