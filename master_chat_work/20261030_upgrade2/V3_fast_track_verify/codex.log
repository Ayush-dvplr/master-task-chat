+#!/usr/bin/env python3
+"""Count distinct task-directory names with a failed QC check ID in v*.md reports."""
+from collections import defaultdict
+from pathlib import Path
+import re
+
+ROOT = Path('/Users/mac/Desktop/Terminal Bench/QC/reports')
+ids = defaultdict(set)
+files = sorted(ROOT.glob('*/v*.md'))
+fail_lines = 0
+for path in files:
+    for line in path.read_text(errors='replace').splitlines():
+        # Detailed numbered failure rows only; skip verdicts, summary tables,
+        # prose mentioning a failed check, and minor/warning rows.
+        if not re.match(r'^\s*\d+\.\s*❌\s+G\d+-\d+', line):
+            continue
+        fail_lines += 1
+        # IDs before the first colon identify every check cited in the finding.
+        head = line.split(':', 1)[0]
+        for check in set(re.findall(r'\b(?:AL|DS|TS|CL|JD|IN)-\d+\b', head)):
+            ids[check].add(path.parent.name)
+
+print(f'files={len(files)} task_dirs={len({p.parent.name for p in files})} fail_lines={fail_lines} check_ids={len(ids)}')
+for check, tasks in sorted(ids.items(), key=lambda kv: (-len(kv[1]), kv[0])):
+    print(f'{check}\t{len(tasks)}')

