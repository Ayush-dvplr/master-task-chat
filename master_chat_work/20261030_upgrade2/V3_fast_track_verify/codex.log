   612	def maybe_launch(ctx: Ctx, st: State) -> list[str]:
   613	    if st["paused"] or not st["queue"] or auto_hold(ctx):
   614	        return []
   615	    active = running(st)
   616	    external = external_harbor_pgids(st, include_gate=False)
   617	    if len(active) + len(external) >= st["max_concurrent"]:
   618	        return []
   619	    budget = docker_budget()
   620	    if budget is None:
   621	        return ["docker is not reachable; not launching"]
   622	    # gate runs hold no slot (R5-12) but still use Docker, so they stay in the Docker budget
   623	    on_docker = len(external_harbor_pgids(st))
   624	    used = [task_resources(ctx, r["task"]) for r in active] + [(DEFAULT_CPUS, DEFAULT_MEM_MB)] * on_docker
   625	    cpus, mem = task_resources(ctx, st["queue"][0]["task"])
   626	    if used and (sum(c for c, _ in used) + cpus > budget[0] or sum(m for _, m in used) + mem > budget[1]):
   627	        return []   # FIFO: wait for room rather than letting a smaller task jump the queue
   628	    return [launch(ctx, st, st["queue"].pop(0))]
