   523	def paid_runs_today() -> list[str]:
   524	    """Paid runs started today (IST) plus queued items, from the MQ state."""
   525	    hs = harness_runs()
   526	    today = now().date()
   527	    out = []
   528	    for r in hs.get("runs", []):
   529	        try:
   530	            started = datetime.fromisoformat(str(r.get("started_at")))
   531	        except ValueError:
   532	            continue
   533	        if (started.astimezone(IST) if started.tzinfo else started).date() == today:
   534	            out.append(str(r.get("task")))
   535	    return out + [q if isinstance(q, str) else str(q.get("task", "?")) for q in hs.get("queue", [])]
