   289	def kill_run(ctx: Ctx, run: Run) -> list[str]:
   290	    """Stop the wrapper, bridge and harbor of a run, then remove its containers."""
   291	    for sig in (signal.SIGTERM, signal.SIGKILL):
   292	        groups = {run["pid"]} | harbor_pgids(run["task"])
   293	        for pg in groups:
   294	            try:
   295	                os.killpg(pg, sig)
   296	            except (ProcessLookupError, PermissionError):
   297	                pass
   298	        deadline = time.time() + 20
   299	        while time.time() < deadline:
   300	            launcher_alive = pid_alive(run["pid"])   # first, so our own exited child gets reaped
   301	            alive = {pg for _, pg, _, _ in ps_table()} & groups
   302	            if not alive and not launcher_alive:
   303	                break
   304	            time.sleep(1)
   305	        else:
   306	            continue
   307	        break
   308	    return remove_containers(trial_prefixes(ctx, run["task"]))
