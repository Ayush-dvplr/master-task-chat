   272	def remove_containers(prefixes: set[str]) -> list[str]:
   273	    starts = tuple(p.lower() + "__" for p in prefixes)
   274	    removed = []
   275	    for kind, ls_cmd, rm_cmd in (
   276	        ("container", ["docker", "ps", "-a", "--format", "{{.Names}}"], ["docker", "rm", "-f"]),
   277	        ("network", ["docker", "network", "ls", "--format", "{{.Name}}"], ["docker", "network", "rm"]),
   278	    ):
   279	        try:
   280	            names = subprocess.run(ls_cmd, capture_output=True, text=True, timeout=60).stdout.split()
   281	            for name in (n for n in names if n.startswith(starts)):
   282	                subprocess.run([*rm_cmd, name], capture_output=True, timeout=120)
   283	                removed.append(f"{kind} {name}")
   284	        except (OSError, subprocess.TimeoutExpired):
   285	            pass
   286	    return removed
