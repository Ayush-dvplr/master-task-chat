"""Tests for scripts/master_queue.py, the master run queue.

A fake scripts/anubis-run stands in for the real wrapper, so no bridge, harbor
run or model request happens. The task's MODE file picks what the fake does:
finish with a score, fail at startup, hit a usage limit, error a trial, or
sleep (so it can hang). Docker is never touched: its budget and container
cleanup are stubbed.
"""

from __future__ import annotations

import shutil
import time
from pathlib import Path

import pytest

import master_queue as mq

FAKE_WRAPPER = r"""#!/bin/bash
[ "$1" = "-o" ] && [ "$4" = "1" ] || { echo "unexpected arguments: $*"; exit 9; }
jobs_root="$2"
task_path="$3"
name="$(basename "$task_path")"
echo "ARGS: $*"
mkdir -p "$jobs_root/${name}-pass1/logs"
case " $* " in
  *" --dry-run "*)
    echo "would run: harbor run -p $task_path --ae LLM_API_KEY=supersecret123 --ae LLM_MAX_OUTPUT_TOKENS=64000 --ve OPENAI_API_KEY=0123456789abcdef0123456789abcdef0123"
    echo "[bridge] credentials OK (token prefix: sk-ant-oat01-abc...)"
    exit 0 ;;
esac
mode="$(cat "$task_path/MODE" 2>/dev/null || echo done)"
echo 'INFO:     127.0.0.1:1 - "POST /chat/completions HTTP/1.1" 200 OK'
case "$mode" in
  fail) echo "Traceback: kiro-cli not logged in"; exit 1 ;;
  limit) echo "RuntimeError: ACP error: The monthly usage limit has been reached (request_id: x)"; exit 0 ;;
  exhausted) echo "EXHAUSTED http 429: all 1 accounts exhausted; soonest reset in 300s"; exit 9 ;;
  early) echo "[anubis] ERROR: usage reporting is not wired"; exit 5 ;;
  errored) mkdir -p "$jobs_root/${name}-pass1/${name}__abc"; echo "INTEGRITY: 1 trial(s) errored"; exit 1 ;;
  nosummary) mkdir -p "$jobs_root/${name}-pass1/${name}__abc"; echo "INTEGRITY: all 1 trial(s) completed cleanly; scores are trustworthy."; exit 0 ;;
  sleep) mkdir -p "$jobs_root/2026-10-19__23-00-00/${name}__abc"; sleep 300 ;;
  done)
