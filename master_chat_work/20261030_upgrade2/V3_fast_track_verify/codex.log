   509	def last_spawn_at(st: dict, fields: dict[str, str]) -> datetime | None:
   510	    """Spawn cutoff: PLAN.md 'Last spawn: HH:MM' or 'N min before Until', else Until - 20 min."""
   511	    if not st.get("until"):
   512	        return None
   513	    until = datetime.fromisoformat(st["until"])
   514	    value = fields.get("last spawn", "")
   515	    m = re.search(r"\b(\d{1,2}):(\d{2})\b", value)
   516	    if m and int(m.group(1)) < 24 and int(m.group(2)) < 60:
   517	        t = until.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
   518	        return t if t <= until else t - timedelta(days=1)
   519	    m = re.search(r"(\d+)\s*min", value)
   520	    return until - timedelta(minutes=int(m.group(1)) if m else LAST_SPAWN_MIN)
