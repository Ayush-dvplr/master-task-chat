import json,collections,pathlib
root=pathlib.Path('master_chat_tasks/auto/runs')
for d in sorted(root.iterdir()):
 p=d/'events.jsonl'
 if not p.exists(): continue
 c=collections.Counter(); chosen=[]
 for i,s in enumerate(p.read_text().splitlines(),1):
  try:x=json.loads(s)
  except:continue
  event=x.get('event') or x.get('type') or str(x)[:40]
  c[event]+=1
  if any(w in s.lower() for w in ['limit','paused','stalled','stall','doom','error','down','final','all idle','stop','harness_add']): chosen.append((i,s[:170]))
 print(d.name,'lines',sum(c.values()),'types',dict(c))
 print('  ', chosen[:25])
