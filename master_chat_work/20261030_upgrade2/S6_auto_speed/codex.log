def run_plan_fields() -> dict[str, str]:
    p = cur().plan
    return plan_fields(p.read_text(errors="replace")) if p.is_file() else {}


def paid_run_cap(fields: dict[str, str]) -> int:
    m = re.search(r"\d+", fields.get("paid runs", ""))
    return int(m.group(0)) if m else PAID_RUNS_PER_DAY


def wind_down_names(fields: dict[str, str], *names: str) -> bool:
    """True when the plan's Wind-down: line names one of `names` (task, sha or slug) as a whole word."""
    value = fields.get("wind-down", "")
    return any(n and re.search(rf"(?<![\w-]){re.escape(n)}(?![\w-])", value) for n in names)


def last_spawn_at(st: dict, fields: dict[str, str]) -> datetime | None:
    """Spawn cutoff: PLAN.md 'Last spawn: HH:MM' or 'N min before Until', else Until - 20 min."""
    if not st.get("until"):
        return None
    until = datetime.fromisoformat(st["until"])
    value = fields.get("last spawn", "")
    m = re.search(r"\b(\d{1,2}):(\d{2})\b", value)
    if m and int(m.group(1)) < 24 and int(m.group(2)) < 60:
        t = until.replace(hour=int(m.group(1)), minute=int(m.group(2)), second=0, microsecond=0)
        return t if t <= until else t - timedelta(days=1)
    m = re.search(r"(\d+)\s*min", value)
    return until - timedelta(minutes=int(m.group(1)) if m else LAST_SPAWN_MIN)


def paid_runs_today() -> list[str]:
    """Paid runs started today (IST) plus queued items, from the MQ state."""
    hs = harness_runs()
    today = now().date()
    out = []
    for r in hs.get("runs", []):
        try:
            started = datetime.fromisoformat(str(r.get("started_at")))
        except ValueError:
            continue
        if (started.astimezone(IST) if started.tzinfo else started).date() == today:
            out.append(str(r.get("task")))
    return out + [q if isinstance(q, str) else str(q.get("task", "?")) for q in hs.get("queue", [])]


