            raise AutoError("auto mode is stopping; nothing new starts (a run named on PLAN.md's Wind-down: "
                            "line may use harness --wind-down)")
        if not wind_down_names(fields, bundle.name):
            raise AutoError(f"--wind-down: PLAN.md's Wind-down: line does not name {bundle.name} "
                            f"({fields.get('wind-down') or 'no Wind-down: line'})")
    refuse_if_limit(st, "harness")
