    61	platforms = ["linux/amd64", "linux/arm64"]
    62	tags = ["<at least one>"]
    63	estimated_duration_sec = <expected model solve time, positive number>
    64	expert_time_estimate_min = <positive number>
    65	junior_time_estimate_min = <must be greater than expert_time_estimate_min>
    66	null_floor = 0.0
    67	discrimination_weight = 1.0
    68	
    69	[verifier]
    70	timeout_sec = <positive number>
    71	environment_mode = "separate"
    72	network_mode = "allowlist"
    73	allowed_hosts = ["api.openai.com", "*.openai.com"]
