+def compact_tests(tests):
+    if len(tests)<=25:
+        return ', '.join(f"`{t['name']}` ({t['weight']})" for t in tests)
+    names=[t['name'] for t in tests]
+    prefix=Counter(n.split('_')[0] for n in names)
+    return f"{len(tests)} failed positive tests; frequent first tokens: {dict(prefix.most_common(8))}. Examples: " + ', '.join(f"`{t['name']}` ({t['weight']})" for t in tests[:12]) + '. Full list: `run_evidence.json:$[id='+tests[0].get('id','task')+'].failed_tests`.'
