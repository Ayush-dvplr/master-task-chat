+#!/usr/bin/env python3
+"""Print saved image IDs for one conservative cleanup category; never calls Docker."""
+import csv
+import json
+import sys
+from pathlib import Path
+
+allowed={'parked/dropped task','dangling'}
+if len(sys.argv)!=2 or sys.argv[1] not in allowed:
