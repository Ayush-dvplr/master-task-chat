   249	def docker_budget() -> tuple[float, int] | None:
   250	    """(cpus, memory MB) Docker can give to runs, or None when Docker is not reachable."""
   251	    try:
   252	        r = subprocess.run(["docker", "info", "--format", "{{.NCPU}} {{.MemTotal}}"],
