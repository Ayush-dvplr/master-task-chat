# selector rules: applied in file order, later rules win

match label:finance set encryption "hsm"
match team:ingest set notify ops,search-oncall
match team:logistics set weight 4
match tier:gold set replicas 3
match team:ads set weight 4
match team:growth set freshness_sla_min 10
match team:logistics set retention_days 7
match label:pii set pii_scan TRUE
match label:ml set tags ml, feature-store
match label:realtime set alerts_enabled TRUE
match tier:gold set partitions "32"
match team:growth set weight 3

match team:risk set notify privacy-desk, search-oncall

match team:ml-platform set retention_days 60
match team:search set replicas "4"
match team:ads set replicas 5
match team:finance set weight 4
match team:security set weight 5
match team:billing set weight 6
match tier:bronze set freshness_sla_min 240

match team:billing set notify "sre-pager, privacy-desk"
match team:media set notify data-oncall , finance-oncall
match team:support set weight "7"
match label:archive set retention_days 1825
match tier:silver set replicas "2"
match label:shared set notify ""

match team:media set retention_days 400

match label:streaming set freshness_sla_min 15

match label:batch set partitions 4
match team:identity set weight 5

