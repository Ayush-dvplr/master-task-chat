{
  "profiles": [
    "dev",
    "prod"
  ],
  "forbidden_keys": [
    "timestamp",
    "generated_at",
    "uuid",
    "random_seed"
  ],
  "required_artifacts": [
    "config.json",
    "report.json",
    "tool.zip",
    "profile_dev.json",
    "profile_prod.json",
    "validation_report.json",
    "summary.json"
  ],
  "max_artifact_bytes": 1048576,
  "bounds": {
    "max_records": [
      150,
      4190
    ],
    "retry_limit": [
      0,
      12
    ],
    "timeout_ms": [
      250,
      25698
    ]
  },
  "allowed_modes": [
    "strict-local",
    "batch-local",
    "audit-local"
  ],
  "journal_envs": [
    "base",
    "dev",
    "prod"
  ]
}
