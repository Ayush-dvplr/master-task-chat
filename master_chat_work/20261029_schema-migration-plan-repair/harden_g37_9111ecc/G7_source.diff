+def _field_remainders(spec: Spec, pol: dict, dom: str, edges: list[tuple], target: str, rest: dict, name: str) -> dict:
+    """Cheapest cost to the canonical schema from (schema, state of one field), every other field unknown."""
+    inc: dict[tuple, list] = defaultdict(list)
+    for edge in edges:
+        if edge[1] == target or edge[2] not in rest:
+            continue
+        reqs = [r.split(":") for r in filter(None, edge[3].split(";"))]
+        for s in "ANV":
+            if not all(_counts(spec, pol, dom, f, s) == (k == "has") for k, f in reqs if f == name):
+                continue
+            outs = {s}
+            for op in filter(None, edge[4].split(";")):
+                kind, arg = op.split(":", 1)
+                if kind == "rename":
+                    a, b = arg.split(">")
+                    if a == name:
+                        outs = {"A"}
+                    elif b == name:
+                        outs = outs | {"N", "V"}
+                elif kind == "drop" and arg == name:
+                    outs = {"A"}
+                elif kind == "add" and arg == name:
+                    outs = {_step_states(spec, pol, dom, {name: x} if x != "A" else {}, op).get(name, "A") for x in outs}
+            for t in outs:
+                inc[(edge[2], t)].append(((edge[1], s), int(edge[5])))
+    best = {(target, s): 0 for s in "ANV"}
+    heap = [(0, (target, s)) for s in "ANV"]
+    while heap:
+        d, here = heapq.heappop(heap)
+        if d > best[here]:
+            continue
+        for there, cost in inc[here]:
+            if d + cost < best.get(there, 1 << 62):
+                best[there] = d + cost
+                heapq.heappush(heap, (d + cost, there))
+    return best
+
