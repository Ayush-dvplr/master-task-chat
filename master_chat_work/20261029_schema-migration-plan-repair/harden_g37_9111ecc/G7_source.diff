+            continue
+        cost = sum(int(by_id[x][5]) for x in plan)
+        if cost >= 1_000_000 or by_id[plan[0]][4] != "" or side in {by_id[x][2] for x in plan}:
+            continue
+        assert len(schemas) <= 1200 and len(edges) <= 6000 and len(fields) <= 10 and len(plan) <= 80
