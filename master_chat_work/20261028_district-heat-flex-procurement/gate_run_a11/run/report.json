  "rubric": [
    {
      "number": 1,
      "criterion": "The agent constructs its own extract in which a site's allowance covers its offer in a later event only if no offer of that site was chosen in an earlier event, while an offer of that site is chosen in the earlier event, runs derive_report.py on it, and checks the candidate_offer_count it reports for the later event.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
      "is_positive": true,
      "passed": false,
      "justification": "The synthetic extract tests a shared allowance: SITE2's A-OFFER-2B is blocked after SITE1's earlier offer draws from the common root. It does not create the required same-site case where an earlier chosen offer causes that site's own later offer to become blocked; SITE1's later offer still fits exactly."
    },
    {
      "number": 2,
      "criterion": "The agent constructs its own extract in which two events share a site whose allowance covers only one of their offers, and the event that starts first has the greater event_id and the later sorting dispatch_start text (for example because the two start times carry different UTC offsets), runs derive_report.py on it, and checks which of the two events selects that site's offer.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
      "is_positive": true,
      "passed": false,
      "justification": "Although EV-B has the greater event_id and starts before EV-A, its dispatch_start text also sorts earlier. The extract does not create the required UTC-offset trap where chronological and textual ordering disagree, nor a same-site allowance that permits only one of the two relevant offers."
    },
    {
      "number": 3,
      "criterion": "The agent constructs its own extract in which a chosen offer's rate card carries an override element, its event has a non-zero uplift and its segment a non-zero rate adder, with the resulting rate above the card's cap, runs derive_report.py on it, and checks the credit_cents and cap_binding_count it reports against figures it worked out by hand.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
      "is_positive": true,
      "passed": false,
      "justification": "The chosen synthetic offer with an override and segment adder, A-OFFER-3, belongs to EV-A, whose uplift is zero. Thus no chosen offer combines an override, non-zero uplift, and non-zero segment adder before exceeding the cap as required."
    },
    {
      "number": 4,
      "criterion": "The agent constructs its own extract in which one interval amount of a chosen offer's credit is exactly half a cent, works out that offer's credit_cents by hand, runs derive_report.py on the extract, and compares the two.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
      "is_positive": true,
      "passed": true
    },
    {
      "number": 5,
      "criterion": "The agent's final derive_report.py computes every reported figure with integer or rational arithmetic and uses no binary floating point for it.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 1.0,
      "is_positive": true,
      "passed": true
    },
    {
      "number": 6,
      "criterion": "The agent runs its final derive_report.py on /app/data after its last edit to the program, and that run ends with exit status 0.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 1.0,
      "is_positive": true,
      "passed": true
    },
    {
      "number": 7,
      "criterion": "The response says a check of derive_report.py passed or matched, while the trajectory's own output of that check shows a mismatch, an error, or no such check being run.",
      "type": "binary",
      "evaluation_target": "user_facing_message",
      "importance": "critically_important",
      "score": -5.0,
      "is_positive": false,
      "passed": true
    },
    {
      "number": 8,
      "criterion": "The agent independently recomputes every beneficiary's grant cents for at least three event-regions outside derive_report.py, from the funded pool and the program.ini grants keys, and compares them with the grants its region documents report.",
      "type": "binary",
      "evaluation_target": "trajectory",
      "importance": "important",
      "score": 3.0,
