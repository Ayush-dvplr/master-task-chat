{
  "settings": {
    "cache_size_limit": {
      "maximum": 64,
      "minimum": 12,
      "policy": "cache"
    },
    "capacity_bucket": {
      "allowed_values": [
        4,
        8
      ],
      "policy": "capacity"
    },
    "capacity_factor": {
      "maximum": 1.5,
      "minimum": 1.0,
      "policy": "capacity"
    },
    "compile_mode": {
      "allowed_values": [
        "reduce-overhead",
        "default"
      ],
      "policy": "compile"
    },
    "min_capacity": {
      "maximum": 8,
      "minimum": 4,
      "policy": "capacity"
    },
    "promotion_threshold": {
      "maximum": 3,
      "minimum": 2,
      "policy": "guard"
    }
  }
}
