  "dynamic_bounds": {
    "max_sessions": {
      "evaluated": "at the moment of the set, against the spine state as of (seq - 1) in ascending seq order",
      "formula": "value <= floor(current(rekey_interval_s) / current(handshake_timeout_ms))",
      "requires": [
        "rekey_interval_s",
        "handshake_timeout_ms"
      ]
    }
  },
  "forbidden_keys": [
    "timestamp",
    "generated_at",
    "uuid",
    "random_seed"
  ],
  "journal_envs": [
    "base",
    "core",
    "edge",
    "dmz",
    "mgmt"
  ],
  "ops": {
    "touch": {
      "note": "A touch whose value is a JSON string of digits for an integer-typed key is rejected on type grounds first, before the equality check.",
      "semantics": "Valid iff value is byte-equal to the current post-replay value for key; otherwise rejected and counted toward J. Never mutates spine.",
      "shape": {
        "key": "str",
        "op": "touch",
        "seq": "int",
        "value": "any"
      }
    }
  },
  "profiles": [
    "core",
    "edge",
    "dmz",
    "mgmt"
  ],
  "zone_matching": {
    "allowed_bytes": [
      "core",
      "edge",
      "dmz",
      "mgmt"
    ],
    "comparison": "byte-exact; no strip, no normalization, no casefold",
    "homoglyphs_rejected": [
      "U+0441 (Cyrillic small ES)",
      "U+200B (zero-width space)",
      "U+00A0 (non-breaking space)",
      "U+FEFF (BOM)"
    ],
    "reserved_never_counted": [
      "svc"
    ]
  },
  "zones": [
    "core",
    "edge",
    "dmz",
    "mgmt"
  ]
}
