{"case_id":"brigantine","purpose":"A single class-K02 stream faces a node whose latency to its region equals the class SLO exactly, which exercises the SLO boundary inside the feasibility check: under strict-less-than that boundary node is not feasible, under non-strict-leq it is. A lower-latency node is feasible under both readings and is selected either way, so brigantine confirms the SLO boundary is handled rather than discriminating the two settlements on its own; case-frigate is the sealed case whose witness separates them.","files":{"fleet_nodes.csv":"node_id,capacity,mtu_class,region,priority_lanes\nN01,1,small,re,1\nN02,1,small,rn,1\n","stream_manifest.csv":"stream_id,tenant_id,class_id,arrival_epoch,deadline_epoch,rate_units,rate_profile\nS001,T01,K02,0,0,3,P02\n","tenants.csv":"tenant_id,floor,ceiling,migration_mult,tenant_region\nT01,0,5,2,re\n","qos_classes.json":"{\"classes\":[{\"class_id\":\"K01\",\"priority_rank\":3,\"slo_max_hops\":2},{\"class_id\":\"K02\",\"priority_rank\":2,\"slo_max_hops\":3},{\"class_id\":\"K03\",\"priority_rank\":1,\"slo_max_hops\":4}]}\n","token_buckets.csv":"node_id,bucket_capacity,refill_num,refill_den,refill_offset\nN01,5,1,1,0\nN02,5,1,1,0\n","mtu_matrix.csv":"mtu_class,class_id,units\nsmall,K01,1\nsmall,K02,1\nsmall,K03,1\n","migration_penalty_table.json":"{\"base\":[{\"tenant\":\"T01\",\"epoch\":0,\"base\":3}]}\n","latency_matrix.csv":"node_id,tenant_region,hops\nN01,re,1\nN02,re,3\n","preemption_ladder.json":"{\"ladder\":[]}\n","epoch_windows.csv":"epoch,duration_num,duration_den,warm_start\n0,1,1,\n","fixed_point_constants.json":"{\"alpha\":5,\"beta\":3,\"gamma\":2,\"damping_num\":3,\"damping_den\":3,\"tolerance\":0,\"max_iterations\":4}\n","packet_rate_profiles.csv":"profile_id,base_rate,class_hint\nP02,3,K02\n"}}
