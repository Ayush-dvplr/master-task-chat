// Upgrade session copy: DCP manual, so a compression happens only when Ayush starts it.
// Place: the folder you start opencode from for the upgrade session (see SETUP_STEPS.md).
{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "manualMode": { "enabled": true, "automaticStrategies": true },
  "compress": {
    "protectUserMessages": true,
    "protectTags": true,
    "showCompression": true
  },
  "turnProtection": { "enabled": true, "turns": 8 },
  "protectedFilePatterns": [
    "**/upgrade_plan/opencode_handoff/AGENTS.md",
    "**/upgrade_plan/RESUME.md",
    "**/upgrade_plan/README.md"
  ],
  "pruneNotification": "detailed"
}
