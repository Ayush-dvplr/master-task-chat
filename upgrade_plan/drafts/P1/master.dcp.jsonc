// DRAFT for the master chat only (Q98: option B, manual). Not applied before PROCEED.
// Place: <root>/master_chat_tasks/.opencode/dcp.jsonc (see README_P1.md, Q108).
{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "manualMode": { "enabled": true, "automaticStrategies": true },
  "compress": {
    "protectUserMessages": true,
    "protectTags": true,
    "showCompression": true
  },
  "turnProtection": { "enabled": true, "turns": 8 },
  "protectedFilePatterns": [
    "**/master_chat_tasks/README.md",
    "**/master_chat_tasks/GOALS.md",
    "**/master_chat_tasks/STATE_CARD.md",
    "**/master_chat_tasks/state.json",
    "**/master_chat_tasks/knowledge/INDEX.md"
  ],
  "pruneNotification": "detailed"
}
