+def _half_totals(part):
+    """Every total of a subset of ``part`` with its best mask, the earliest id as the top bit."""
+    best = {0: 0}
+    size = len(part)
+    for place, (_, amount) in enumerate(part):
+        bit = 1 << (size - 1 - place)
+        for total, mask in list(best.items()):
+            grown = total + amount
+            if best.get(grown, -1) < (mask | bit):
+                best[grown] = mask | bit
+    return best
+
+
+def _redeem_halves(target, usable):
+    """The same answer when no reachable-total form fits: the ids are split into an earlier and
+    a later half, every total of each half is listed, and the two lists are matched.
+
+    A set whose list comes first holds the smallest id where two sets differ, so with the
+    earliest id as the top bit the first list is the largest mask: first over the earlier
+    half among the totals that can still be finished, then over the later half.
+    """
+    middle = len(usable) // 2
+    early, late = usable[:middle], usable[middle:]
+    early_best, late_best = _half_totals(early), _half_totals(late)
+    late_sums = sorted(late_best)
+    standing = 0
+    for total in early_best:
+        if total <= target:
+            room = target - total
+            place = bisect_right(late_sums, room) - 1
+            standing = max(standing, total + late_sums[place])
+    mask = max(m for total, m in early_best.items()
+               if total <= standing and standing - total in late_best)
+    taken = sum(amount for place, (_, amount) in enumerate(early) if mask >> (middle - 1 - place) & 1)
+    later = late_best[standing - taken]
+    chosen = [name for place, (name, _) in enumerate(early) if mask >> (middle - 1 - place) & 1]
+    chosen += [name for place, (name, _) in enumerate(late) if later >> (len(late) - 1 - place) & 1]
+    return sorted(chosen)
+
