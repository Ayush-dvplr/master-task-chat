+def _stop_untrusted(group):
+    """Kill the run's process group, then every process the run user still
+    owns, so a child the engine forked off cannot outlive its check."""
+    try:
+        os.killpg(group, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError):
+        pass
+    if os.geteuid() != 0:
+        return
+    for _ in range(20):
+        left = _run_user_processes()
+        if not left:
+            return
+        for pid in left:
+            try:
+                os.kill(pid, signal.SIGKILL)
+            except (ProcessLookupError, PermissionError):
+                pass
+        time.sleep(0.05)
+
