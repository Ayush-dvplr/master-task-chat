+def _private_corpus(seed, legacy=()):
+    """The round as the verifier keeps it, in a directory only the verifier
+    can open. Every reference is built from this copy."""
+    key = ("private", seed, legacy)
+    with _BUILD_LOCK:
+        if key not in _CACHE:
+            private = Path(tempfile.mkdtemp(prefix="slwopt-private-"))
+            os.chmod(private, 0o700)
+            _CACHE[key] = write_corpus(private, seed, legacy)
+        return _CACHE[key]
+
+
+def _public_copy(private, tag):
+    """The copy of a round the engine is pointed at."""
+    root = _scratch(tag)
+    shutil.copytree(private, root, dirs_exist_ok=True)
+    return _seal(root)
