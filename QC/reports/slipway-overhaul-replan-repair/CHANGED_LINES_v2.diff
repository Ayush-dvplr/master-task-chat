+def _run_user_processes():
+    """The live processes the run user owns, read from /proc."""
+    found = []
+    proc_root = Path("/proc")
+    if not proc_root.is_dir():
+        return found
+    for entry in proc_root.iterdir():
+        if not entry.name.isdigit():
+            continue
+        try:
+            status = (entry / "status").read_text()
+        except OSError:
+            continue
+        uid = next((line.split()[1:2] for line in status.splitlines()
+                    if line.startswith("Uid:")), [])
+        if uid == [str(RUN_UID)] and "State:\tZ" not in status:
+            found.append(int(entry.name))
+    return found
+
