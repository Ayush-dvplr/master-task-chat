+def _named_missing(stderr: object) -> list[str]:
+    names = []
+    for line in str(stderr).splitlines():
+        at = line.find("missing input: ")
+        if at >= 0:
+            names.append(line[at + len("missing input: "):].strip())
+    return names
+
+
+def _check_several_missing(pool: list[str], count: int, seed: int, label: str, unsorted: bool) -> None:
+    _full_run_ok()
+    rng = random.Random(seed)
+    while True:
+        gone = sorted(rng.sample(pool, count), key=REF_INPUTS.index)
+        if not unsorted or gone[0] != min(gone):
+            break
+    files = {k: v for k, v in _hidden_files().items() if k not in gone}
+    run = _run(files, label)
+    assert run["returncode"] not in (0, None), "exit status %r with %s absent" % (run["returncode"], ", ".join(gone))
+    named = _named_missing(run["stderr"])
+    assert gone[0] in named, "with %s absent, stderr lacks 'missing input: %s'" % (", ".join(gone), gone[0])
+    later = [name for name in gone[1:] if name in named]
+    assert not later, "with %s absent, stderr also names later file %s" % (", ".join(gone), ", ".join(later))
+
+
+def _check_missing_references_order() -> None:
+    _check_several_missing([k for k in REF_INPUTS if k not in REF_FILES.values()], 3, HIDDEN_SEED + 7,
+                           "missing-references", True)
+
+
+def _check_missing_collectors_order() -> None:
+    _check_several_missing([REF_FILES[r] for r in REF_REGIONS], 2, HIDDEN_SEED + 8, "missing-collectors", False)
+
+
