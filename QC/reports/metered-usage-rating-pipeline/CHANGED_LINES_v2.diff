+_RUN_LOCK = threading.Lock()
+
+
+def _dropped_uid_pids() -> list[int]:
+    """Live processes of the uid the delivered program runs as (zombies excluded)."""
+    uid = pwd.getpwnam("nobody").pw_uid
+    found = []
+    for entry in Path("/proc").iterdir():
+        if not entry.name.isdigit():
+            continue
+        with contextlib.suppress(OSError):
+            if entry.stat().st_uid == uid and (entry / "stat").read_text().rsplit(")", 1)[1].split()[0] != "Z":
+                found.append(int(entry.name))
+    return found
+
+
+def _reap(proc: subprocess.Popen) -> None:
+    """Kill the run's own session, then every process left under the dropped uid, before the check returns."""
+    with contextlib.suppress(ProcessLookupError, PermissionError):
+        os.killpg(proc.pid, signal.SIGKILL)
+    if os.geteuid() == 0:
+        for _ in range(100):
+            pids = _dropped_uid_pids()
+            if not pids:
+                break
+            for pid in pids:
+                with contextlib.suppress(ProcessLookupError, PermissionError):
+                    os.kill(pid, signal.SIGKILL)
+            time.sleep(0.02)
+    proc.kill()
+    with contextlib.suppress(subprocess.TimeoutExpired):
+        proc.communicate(timeout=5)
+
+
