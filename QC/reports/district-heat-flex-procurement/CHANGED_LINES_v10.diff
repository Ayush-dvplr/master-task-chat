+    region_of = {(x["event_id"], x["sid"]): _region_of_code(x["code"]) for x in spec["sites"]}
+
+    def ticks(o: dict[str, Any]) -> int:
+        return sum(_q(r * m, wh) for t, (r, m) in enumerate(zip(o["r"], o["m"]))
+                   if (o["offer_id"], t + 1) not in spec.get("gaps", set()))
+
+    def free(sid: str) -> bool:
+        return sid in spec["allowances"] and sid not in spec["draws"] and sid not in spec["draws"].values()
+
+    def chosen_at(picks: dict, eid: str, sids: set[str]) -> list[dict[str, Any]]:
+        return [offer[i] for (e, _), ids in picks.items() if e == eid for i in ids if offer[i]["sid"] in sids]
+
+    def used_before(order: list[str], picks: dict, eid: str, sids: set[str]) -> int:
+        return sum(ticks(o) for e in order[:order.index(eid)] for o in chosen_at(picks, e, sids))
+
+    _, picks = _season(spec, tag)
+    usable = sorted(i for ids in picks.values() for i in ids if i not in late and any(offer[i]["r"]))
+    gaps: set[tuple[str, int]] = set()
+    for i in (rng.pick(usable) for _ in range(min(2, len(usable)))):
+        widest = max(range(len(offer[i]["r"])), key=lambda t: offer[i]["r"][t])
+        gaps.add((i, widest + 1))
+    spec["gaps"] = gaps
+    order, picks = _season(spec, tag)
+    pairs = []
+    for eid in order:
+        here = [o for o in chosen_at(picks, eid, set(spec["allowances"])) if free(o["sid"]) and ticks(o) > 0]
+        pairs += [(eid, x["sid"], y["sid"]) for x in here for y in here
+                  if region_of[(eid, x["sid"])] < region_of[(eid, y["sid"])]]
+    rng.shuffle(pairs)
+    for eid, holder, other in pairs[:6]:
+        keep = (spec["allowances"][holder], spec["allowances"][other])
+        spec["draws"][other] = holder
+        spec["allowances"][holder], spec["allowances"][other] = 10 ** 9, 0
+        order, picks = _season(spec, tag)
+        both = chosen_at(picks, eid, {holder, other})
+        if len({o["sid"] for o in both if ticks(o) > 0}) == 2:
+            spec["allowances"][holder] = (used_before(order, picks, eid, {holder, other})
+                                          + sum(ticks(o) for o in both) - 1)
+            order, picks = _season(spec, tag)
+            if len({o["sid"] for o in chosen_at(picks, eid, {holder, other}) if ticks(o) > 0}) == 2:
+                break
+        del spec["draws"][other]
+        spec["allowances"][holder], spec["allowances"][other] = keep
