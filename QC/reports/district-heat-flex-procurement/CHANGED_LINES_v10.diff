+def _season(spec: dict[str, Any], tag: str) -> tuple[list[str], dict[tuple[str, str], list[str]]]:
+    """Event ids in season order and the reference's chosen offer ids per (event_id, region)."""
+    folder = _scratch() / f"season-{tag}"
+    if folder.exists():
+        shutil.rmtree(folder)
+    write_extract(folder, spec)
+    files = reference(folder, frozenset())
+    shutil.rmtree(folder)
+    starts = {e["event_id"]: datetime.fromisoformat(e.get("start") or f"2026-11-{1 + k // 24:02d}T{k % 24:02d}:00:00+01:00")
+              for k, e in enumerate(spec["events"])}
+    order = sorted(sorted(starts, reverse=True), key=lambda eid: starts[eid])
+    return order, {(e["event_id"], r): list(e["selected_offer_ids"]) for r in REGIONS
+                   for e in files[f"region_{r}.json"]["events"]}
+
+
+def _plant_ledger(spec: dict[str, Any], rng: Rng, tag: str) -> None:
+    """H1 plants: a missing profile row of a chosen offer, one allowance drawn in two regions of one event, and an
+    allowance whose remainder equals the relief ticks of the offer chosen against it."""
